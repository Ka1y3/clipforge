# Twitch (https://dev.twitch.tv/console) — redirect: http://localhost:8000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Google/YouTube (console.cloud.google.com, API YouTube Data v3) — redirect: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok (developers.tiktok.com) — app de type Desktop, redirect: http://localhost:8000/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optionnel : IA pour noter l'intérêt des séquences (coût faible : seulement sur les meilleurs candidats)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Whisper : tiny|base|small|medium (small conseillé en CPU)
WHISPER_MODEL=small
WHISPER_LANG=fr
